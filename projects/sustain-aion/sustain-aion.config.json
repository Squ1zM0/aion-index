{
  "$schema": "https://aion-protocol.ai/schemas/sustain-aion-v1.json",
  "version": "1.0",
  "enabled": true,
  
  "rotation": {
    "mode": "adaptive_round_robin",
    "maxRetries": 3,
    "retryDelayMs": 1000,
    
    "categories": {
      "default": {
        "models": [
          "ollama/kimi-k2.5:cloud",
          "ollama/gemma3:4b",
          "ollama/gpt-oss:120b-cloud",
          "google/gemini-2.0-flash",
          "openai/gpt-4.1-mini"
        ],
        "rotationStrategy": "round_robin",
        "healthCheck": {
          "enabled": true,
          "failureThreshold": 3,
          "recoveryPeriodMs": 300000
        }
      },
      
      "reasoning": {
        "models": [
          "ollama/kimi-k2.5:cloud",
          "ollama/gpt-oss:120b-cloud",
          "openai/gpt-4-turbo"
        ],
        "rotationStrategy": "weighted_round_robin",
        "weights": {
          "ollama/kimi-k2.5:cloud": 0.4,
          "ollama/gpt-oss:120b-cloud": 0.4,
          "openai/gpt-4-turbo": 0.2
        }
      },
      
      "vision": {
        "models": [
          "ollama/kimi-k2.5:cloud",
          "ollama/gemma3:4b",
          "google/gemini-2.0-flash"
        ],
        "rotationStrategy": "round_robin"
      },
      
      "code": {
        "models": [
          "openai/codex-mini-latest",
          "ollama/kimi-k2.5:cloud",
          "ollama/gpt-oss:120b-cloud"
        ],
        "rotationStrategy": "performance_based"
      },
      
      "local_fallback": {
        "models": [
          "ollama/gemma3:4b"
        ],
        "rotationStrategy": "single",
        "trigger": "all_remote_unavailable"
      }
    },
    
    "classificationRules": [
      {
        "name": "vision_tasks",
        "if": {
          "hasAttachment": "image",
          "or": [{ "contains": "describe" }, { "contains": "analyze image" }]
        },
        "then": { "category": "vision", "priority": "high" }
      },
      {
        "name": "reasoning_tasks",
        "if": {
          "containsAny": ["think through", "reasoning", "step by step", "analyze deeply", "explain why"]
        },
        "then": { "category": "reasoning", "priority": "high" }
      },
      {
        "name": "code_tasks",
        "if": {
          "containsAny": ["code", "function", "script", "program", "implement", "debug", " refactor"]
        },
        "then": { "category": "code", "priority": "high" }
      },
      {
        "name": "long_context",
        "if": {
          "contextLength": { "gt": 50000 }
        },
        "then": { 
          "category": "default",
          "filter": { "minContextWindow": 100000 },
          "priority": "medium"
        }
      },
      {
        "name": "default_fallback",
        "if": {},
        "then": { "category": "default", "priority": "low" }
      }
    ]
  },
  
  "health": {
    "checkIntervalMs": 60000,
    "defaultFailureThreshold": 3,
    "defaultRecoveryPeriodMs": 300000,
    
    "circuitBreaker": {
      "enabled": true,
      "failureThreshold": 5,
      "timeoutMs": 30000,
      "halfOpenRetries": 2
    }
  },
  
  "persistence": {
    "statePath": "workspace/.sustain-aion/state.json",
    "backupCount": 3,
    "flushIntervalMs": 5000,
    "statAggregationPeriods": ["hourly", "daily", "weekly"]
  },
  
  "notifications": {
    "discord_webhook": "https://discord.com/api/webhooks/1468082420946567250/Qi9awCXDLHahHHpZRqp-jSP5NBD6i4ObLJqnRcH6KJN2al4vpoqskI9rwm5XH4SoPGvu"
  },
  
  "logging": {
    "level": "info",
    "logRotations": true,
    "logHealthChanges": true,
    "logCategoryAssignments": true
  }
}
