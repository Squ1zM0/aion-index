{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aion-protocol.ai/schemas/sustain-aion-state-v1.json",
  "title": "Sustain-AI0N Rotation State",
  "description": "Persistent state for model rotation tracking",
  "type": "object",
  "required": ["schemaVersion", "lastUpdated", "globalSequence", "categoryPositions", "modelHealth"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Schema version for migration support"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last state update"
    },
    "globalSequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Global request counter across all categories"
    },
    "categoryPositions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["lastModelId", "sequenceInCategory", "modelsInPool"],
        "properties": {
          "lastModelId": {
            "type": "string",
            "description": "ID of last selected model in this category"
          },
          "sequenceInCategory": {
            "type": "integer",
            "minimum": 0,
            "description": "Request counter for this category"
          },
          "modelsInPool": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Current available models in rotation pool"
          }
        }
      }
    },
    "modelHealth": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["lastUsed", "successCount", "failureCount", "isHealthy"],
        "properties": {
          "lastUsed": {
            "type": "string",
            "format": "date-time"
          },
          "successCount": {
            "type": "integer",
            "minimum": 0
          },
          "failureCount": {
            "type": "integer",
            "minimum": 0
          },
          "avgResponseTime": {
            "type": "number",
            "minimum": 0
          },
          "lastFailure": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "consecutiveFailures": {
            "type": "integer",
            "minimum": 0
          },
          "isHealthy": {
            "type": "boolean"
          }
        }
      }
    },
    "usageStats": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "requestsByModel": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          },
          "tokensByModel": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          },
          "errorsByModel": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          }
        }
      }
    }
  }
}
