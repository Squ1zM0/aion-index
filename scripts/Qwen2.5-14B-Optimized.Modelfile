FROM qwen2.5:14b

# AIOS-Optimized Parameters for i7-9700K, 16GB RAM, RTX 2080 4GB VRAM

# Context window - 8K is safe for 16GB system
PARAMETER num_ctx 8192

# GPU layer offloading - 25 layers ≈ 3GB GPU, remaining on CPU
PARAMETER num_gpu 25

# Temperature and sampling
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER repeat_last_n 64

# Generation limits
PARAMETER num_predict -1      # Unlimited (set per-request as needed)
PARAMETER num_thread 6        # Leave 2 cores for system

# Flash attention for memory efficiency (if model supports)
PARAMETER flash_attn true

# System prompt optimized for operation
SYSTEM """You are an AI assistant running on optimized local hardware (i7-9700K, 16GB RAM, RTX 2080). Provide concise, accurate responses. Be direct and avoid unnecessary verbosity to ensure efficient operation."""
