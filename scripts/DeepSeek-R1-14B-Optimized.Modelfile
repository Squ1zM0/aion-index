FROM deepseek-r1:14b

# AIOS-Optimized for Reasoning Models (more conservative for thinking overhead)
PARAMETER num_ctx 8192
PARAMETER num_gpu 22          # Slightly fewer layers for reasoning overhead
PARAMETER temperature 0.6     # Lower temp for more focused reasoning
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.05

# Limit thinking length to prevent excessive token generation
PARAMETER num_predict 4096    # Cap total response length
PARAMETER num_thread 6
PARAMETER flash_attn true

# Optimized for technical tasks on constrained hardware
SYSTEM """You are a reasoning-optimized AI running on local hardware with finite resources. Provide thorough but concise analysis. Focus on practical solutions and avoid excessive verbosity in your thinking process."""
